# Copy to .env and fill in.

# Token from @BotFather
BOT_TOKEN=
STORAGE_CHAT_ID=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=tarot_bot
DB_USER=postgres
DB_PASSWORD=postgres

LOG_LEVEL=INFO
# The card of the day changes at midnight in this time zone.
BOT_TIMEZONE=Europe/Minsk
DEFAULT_DECK_CODE=rider_waite

# AI providers, tried in this order; a provider without a key is skipped.
AI_PROVIDERS=openrouter
# https://openrouter.ai/settings/keys; free models end in ":free" (50 requests a day in total)
OPENROUTER_API_KEY=
# Up to 3, comma-separated: OpenRouter tries the next one if the first is busy.
OPENROUTER_MODEL=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free
# Not available from Belarus (Groq) or paid (Mistral); kept in case that changes.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# Journal of AI requests with prompts and answers (JSON Lines); empty to turn off.
# AI_REQUEST_LOG_PATH=logs/ai_requests.jsonl
